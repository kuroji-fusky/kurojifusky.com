---
import Hero from "$components/landing/Hero.svelte"
import Layout from "$layouts/Layout.astro"
import ImageWrapper from "$components/ImageWrapper.svelte"
import ShuffleIcon from "~icons/lucide/shuffle"
import Link from "$components/Link.astro"
---

<Layout title="Under construction | Kuro">
  <div class="flex flex-col justify-center items-center h-screen">
    <section id="__interstitial" class="flex flex-col gap-y-3 px-6 [&_img]:w-[380px] *:first:h-[380px]">
      <ImageWrapper
        src="https://fuskylabs-cdn.imgix.net/commissions/24/MintyNebula_Kuro.png?w=380&h=380&fm=webp"
      />
      <div class="flex">
        <span id="artist" class="flex-1">
          <span>by</span>
          <Link href="https://www.etsy.com/shop/MintyNebula">
            MintyNebula
          </Link>
        </span>
        <button class="shrink-0">
          <ShuffleIcon />
        </button>
      </div>
    </section>
    <section class="mt-10 text-center">
      <h1 class="font-kuro-hero-heading text-3xl md:text-4xl lg:text-5xl leading-none">Under construction</h1>
      <p class="mt-6">This site so trashy it's basically a biohazard at this point lol</p>
    </section>
  </div>
</Layout>
<script>
  const CUTIES_BASE_URL = "https://fuskylabs-cdn.imgix.net/commissions";

  const commissionsMap = [
    [3, "Kuro_MintyChipMocha.png", "MintyChipMocha", "www.youtube.com/@MintyChipMocha"],
    [3, "Kuro_dougly.png", "sadcat16hrz", "x.com/sadcat16hrz"],
    [3, "Kuro_toboshiro.png", "toboshiro", "www.etsy.com/shop/toboshirosworkshop"],
    [3, "Kuro_YCH_NyxieDraws.png", "NyxieDraws", "www.etsy.com/shop/NyxieDraws"],
    [4, "Kinter_ForestLeap-W.png", "ForestLeap", "www.etsy.com/shop/ForestLeapCommission"],
    [4, "MintyNebula_Kinter.png", "MintyNebula", "www.etsy.com/shop/MintyNebula"],
    [4, "MintyNebula_Kuro.png", "MintyNebula", "www.etsy.com/shop/MintyNebula"],
  ];

  const c = document.getElementById("__interstitial")!;

  c.getElementsByTagName("button")[0].addEventListener("click", () => {
    const rnd = commissionsMap[Math.floor(Math.random() * commissionsMap.length)]

    c.getElementsByTagName("img")[0].src = CUTIES_BASE_URL.concat("/2", rnd[0].toString(), "/", rnd[1].toString(), "?w=380&h=380&fm=webp")
    c.querySelector("#artist > a > span")!.textContent = rnd[2].toString()
    c.querySelector("#artist > a")!.href = "https://".concat(rnd[3].toString())
  })
</script>

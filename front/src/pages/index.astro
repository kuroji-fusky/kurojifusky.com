---
import BaseLayout from "../layouts/BaseLayout.astro";
import XPWindow from "../lib/components/XPWindow.svelte";
import XPWindowButton from "../lib/components/XPWindowButton.svelte";

const links = [
  { href: "www.youtube.com/@kinter_atwood", text: "YouTube 2nd Channel" },
  { href: "github.com/kuroji-fusky", text: "GitHub" },
  { href: "furry.engineer/@kurojifusky", text: "Mastodon" },
  { href: "ko-fi.com/kuroji_fusky", text: "Ko-fi" },
  {
    href: "deviantart.com/SoSkeptically",
    text: "DeviantArt (don't ask why I still have this)",
  },
];

const hardcodedVideos = [
  {
    id: "nO67ZieoQV8",
    title: "What It Sounds Like - Nick & Judy (Zootopia AMV)",
  },
  { id: "GnSgzut_T5I", title: "Plainrock124 YTP Supercut + Extras: THE MOVIE" },
  {
    id: "SRkuMd8du9I",
    title: "[YTP] BringGuG SouSios comes out of the closet",
  },
];
---

<BaseLayout
  title="Kuro's Corner"
  description="a trash website for a trash furry"
>
  <div class="max-w-4xl mx-auto px-3.5 mt-16">
    <XPWindow
      title="welcome to my shitty website"
      class="bg-neutral-300 text-black px-5 py-4 prose-headings:font-bold prose-h2:text-xl prose-h2:my-2 space-y-4"
    >
      <div slot="customTitle" class="inline-flex gap-x-1">
        <img src="./icon_128.png" class="size-5 pointer-events-none" alt="" draggable="false" />
        <span class="text-sm font-semibold text-shadow-sm text-shadow-black"
          >welcome to my shitty website</span
        >
      </div>
      <div slot="windowActions" class="flex gap-x-0.5 items-center">
        <XPWindowButton disabled />
      </div>
      <section>
        <article class="space-y-1.5">
          <h2 class="mt-0! mb-2!">about me</h2>
          <p>
            I'm a 24-year-old hobbyist from the Philippines; mainly focused on
            software development and video/VFX work.
          </p>
          <p>
            Been doing this since 2013, and I go by a fox-husky (or a fusky)
            hybrid on the interwebz.
          </p>
          <p>
            He/him, secretly a femboy, or not, idk, nick wilde is my daddy 4lyfe
          </p>
        </article>
      </section>

      <section>
        <article>
          <h2 class="mb-3!">latest videos on teh youtubes</h2>
          <div class="flex sm:flex-row flex-col gap-3 mb-4">
            {
              hardcodedVideos.map(({ id, title }) => (
                <a
                  href={`https://www.youtube.com/watch?v=${id}`}
                  target="_blank"
                  class="group"
                >
                  <img
                    src={`https://i.ytimg.com/vi/${id}/mqdefault.jpg`}
                    alt="no"
                    class="mb-1.5 aspect-video w-full object-cover border-2 border-black group-hover:border-blue-800"
                  />
                  <span class="underline text-blue-600 group-hover:text-blue-800 text-base">
                    {title}
                  </span>
                </a>
              ))
            }
          </div>
        </article>
      </section>
      <section>
        <h2>s0me linkies</h2>
        <ul class="*:list-inside *:list-disc">
          {
            links.map(({ href, text }) => (
              <li>
                <a
                  href={`https://${href}`}
                  target="_blank"
                  class="underline text-blue-600 hover:text-blue-800"
                >
                  {text}
                </a>
              </li>
            ))
          }
        </ul>
      </section>
      <section>
        <h2>Stuff coming soon !!!11!</h2>
        <ul class="*:list-inside *:list-disc">
          <li>projects</li>
          <li>blogs</li>
          <li>nostalgia journal</li>
          <li>detailed about me</li>
        </ul>
      </section>
    </XPWindow>
  </div>
</BaseLayout>

---
import Clamp from "$components/Clamp.astro";
import SectionCentered from "$components/Sections/SectionCentered.astro";
import SectionPlain from "$components/Sections/SectionPlain.astro";
import Layout from "$layouts/Layout.astro";
---

<Layout title="kuro homepage">
  <Clamp class="my-12 space-y-40 prose-p:leading-relaxed">
    <SectionCentered heading="Featured projects" class="grid grid-cols-2 gap-6">
      {
        [...Array(5)].map((_) => (
          <article class="group">
            <div class="rounded-2xl overflow-hidden relative w-full aspect-[16/10] bg-blue-900" />
            <div class="space-y-2 mt-4">
              <h2 class="text-2xl font-semibold group-hover:text-kuro-lavender-200">
                Title
              </h2>
              <p class="opacity-65">
                Lorem ipsum, dolor sit amet consectetur adipisicing elit. Id
                expedita odio eligendi.
              </p>
              <div>
                <span>2021</span>
                <span>Type</span>
              </div>
            </div>
          </article>
        ))
      }
    </SectionCentered>
    <SectionPlain level={1} heading="About me">Placeholder</SectionPlain>
    <SectionPlain level={2} heading="More">Placeholder</SectionPlain>
  </Clamp>
</Layout>

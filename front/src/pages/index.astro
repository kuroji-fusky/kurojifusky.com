---
import BaseLayout from "$layouts/BaseLayout.astro";
import XPWindow from "$lib/components/XPWindow.svelte";

const links = [
  { href: "www.youtube.com/@kuroji_fusky", text: "YouTube" },
  { href: "www.youtube.com/@kinter_atwood", text: "YouTube 2nd Channel" },
  { href: "github.com/@kuroji-fusky", text: "GitHub" },
  { href: "furry.engineer/@kurojifusky", text: "Mastodon" },
  { href: "ko-fi.com/kuroji_fusky", text: "Ko-fi" },
  {
    href: "deviantart.com/SoSkeptically",
    text: "DeviantArt (don't ask why I still have this)",
  },
];
---

<BaseLayout title="kuro homepage">
  <section class="mx-auto max-w-7xl px-4 mt-20 cursor-default">
    <XPWindow title="Under construction" class="bg-neutral-200 text-black">
      <div class="p-6 space-y-3">
        <article>
          <p class="mb-2">
            Currently restructuring my portfolio to have that XP-seque nostalgia
            baby~
          </p>
          <p>
            And before you ask - nope, it's not dead! It just needs... <strong
              >some work.</strong
            > In the meantime, here are some social links and my latest videos. I'll
            periodically update new pages when they become available.
          </p>
        </article>
        <section>
          <ul>
            {
              links.map(({ href, text }) => (
                <li class="list-inside list-disc">
                  <a
                    href={`https://${href}`}
                    target="_blank"
                    class="underline text-blue-600"
                  >
                    {text}
                  </a>
                </li>
              ))
            }
          </ul>
        </section>
      </div>

      <footer
        class="text-xs px-6 py-4 opacity-70 flex bg-white shadow-inner shadow-neutral-300 border-t"
      >
        <p class="flex-1">
          This site doesn't track you. &copy; 2026 Kuroji Fusky LLC
        </p>
        <p>Build v10.1</p>
      </footer>
    </XPWindow>
  </section>
</BaseLayout>

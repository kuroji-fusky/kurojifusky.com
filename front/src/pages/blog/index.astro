---
import Clamp from "$components/Clamp.astro";
import PageHeading from "$components/PageHeading.astro";
import BlogCompact from "$components/blog/BlogCompact.astro";
import { TocIcon } from "$components/icons";
import MainLayout from "$layouts/MainLayout.astro";
---

<MainLayout title="Blog">
  <Clamp class="px-6">
    <PageHeading title="Blog posts" />
    <nav
      class="bg-kuro-dark2 sticky top-10 z-10 flex justify-between items-center"
    >
      <div class="flex gap-x-2 text-sm font-kuro-mono py-3">
        <button class="px-3 py-1 rounded-md bg-kuro-lavender-800">Latest</button
        >
        <button class="px-3 py-1 rounded-md bg-kuro-lavender-800">Design</button
        >
        <button class="px-3 py-1 rounded-md bg-kuro-lavender-800"
          >Engineering</button
        >
        <button class="px-3 py-1 rounded-md bg-kuro-lavender-800"
          >Others/Personal</button
        >
      </div>
      <div class="inline-flex gap-x-1">
        <button class="p-1.5 bg-purple-800 rounded-md">
          <TocIcon />
        </button>
        <button class="p-1.5 bg-purple-800 rounded-md">
          <TocIcon />
        </button>
      </div>
    </nav>
    <section class="space-y-8">
      <div class="grid grid-cols-1" role="list">
        {
          [...Array(8)].map(() => (
            <div
              class="border-kuro-lavender-400/75 dark:border-kuro-lavender-300/25 border-dashed border-b-2"
              role="listitem"
            >
              <BlogCompact />
            </div>
          ))
        }
      </div>
      <div class="grid place-items-center">
        <button class="rounded-4xl px-6 border py-2">Load moar blogs</button>
      </div>
    </section>
  </Clamp>
</MainLayout>

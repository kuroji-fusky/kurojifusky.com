---
import BaseLayout from "$layouts/BaseLayout.astro";
import Button from "$lib/components/Button.svelte";
import Clamp from "$lib/components/Clamp.astro";

const { slug } = Astro.params;

// Dummy data
const dummyData = [
  {
    slug: "kinter",
    name: "Kinter",
    description: "A big wolfie",
    full_name: "Kinter Atwood",
  },
  {
    slug: "kuro",
    name: "Kuro",
    full_name: null,
    description: "Yes",
  },
];

const data = dummyData.find((x) => x.slug === slug);

if (!data) {
  return new Response(null, { status: 404 });
}
---

<BaseLayout title={data?.name}>
  <div class="contents *:px-3">
    <Clamp as="header" class="mt-6 space-y-6">
      <h1 class="text-5xl font-bold lg:text-left text-center">{data?.name}</h1>

      <figure class="flex flex-col justify-center items-center">
        <img class="block size-96 aspect-video"></img>
        <figcaption class="mt-2">Ref sheet</figcaption>
      </figure>

      <article>
        <p>{data?.description}</p>
      </article>

      <div>
        <Button>
          <Fragment>See artwork for {data?.name}</Fragment>
        </Button>
      </div>
    </Clamp>

    <Clamp as="section">
      <h2>Recent artworks</h2>
      <div></div>
    </Clamp>
  </div>
</BaseLayout>

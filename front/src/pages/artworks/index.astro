---
import Clamp from "$components/Clamp.astro";
import ImageWrapper from "$components/ImageWrapper.astro";
import Checkbox from "$components/Checkbox.astro";
import MainLayout from "$layouts/MainLayout.astro";
import { ExtLinkIcon } from "$components/icons";
import test_items from "./cuties.json";

const SonaOptions = [
  {
    key: "kuro",
    label: "Kuro",
  },
  {
    key: "kinter",
    label: "Kinter",
  },
] as const;
---

<MainLayout title="Artworks" description="Look at all of these cuties, goddamn">
  <Clamp class="py-4 flex justify-between text-sm gap-x-2">
    <button> Filters </button>
  </Clamp>
  <div class="px-3 flex gap-x-6">
    <aside
      class="w-48 shrink-0 sticky top-12 self-start grid space-y-3 text-sm"
    >
      <div role="group" id="art-characters" class="grid space-y-1">
        <h2 class="mb-1.5 opacity-75">Character</h2>
        <Checkbox name="art-characters" queryValue="kuro" labelName="Kuro" />
        <Checkbox
          name="art-characters"
          queryValue="kinter"
          labelName="Kinter"
        />
      </div>
      <div role="group" id="art-category" class="grid space-y-1">
        <h2 class="mb-1.5 opacity-75">Category</h2>
        <Checkbox
          name="art-category"
          queryValue="icon"
          labelName="Icon/Headshot"
        />
        <Checkbox name="art-category" queryValue="mid" labelName="Mid" />
        <Checkbox name="art-category" queryValue="full" labelName="Fullbody" />
      </div>
      <div role="group" id="art-type" class="grid space-y-1">
        <h2 class="mb-1.5 opacity-75">Type</h2>
        <Checkbox
          name="art-type"
          queryValue="commission"
          labelName="Commission"
        />
        <Checkbox name="art-type" queryValue="ych" labelName="YCH" />
        <Checkbox name="art-type" queryValue="gift" labelName="Free/Gift Art" />
        <Checkbox
          name="art-type"
          queryValue="prize-winner"
          labelName="Prize winner"
        />
      </div>
      <div role="group" id="price-currency" class="grid space-y-1">
        <h2 class="mb-1.5 opacity-75">Currency</h2>
        <label for="cur-usd">
          <input type="radio" name="currency" id="cur-usd" checked />
          <span>USD</span>
        </label>
        <label for="cur-php">
          <input type="radio" name="currency" id="cur-php" />
          <span>PHP</span>
        </label>
      </div>
      <div>
        <script>
          const cb = Array.from(
            document.querySelectorAll("cool-checkbox-thats-not-cringe input"),
          );

          document.getElementById("clear-filters")?.addEventListener("click", () => {
            console.log("BEEECH")
          })
        </script>
        <button id="clear-filters" class="block border py-2 px-3 rounded-md">Clear filters</button>
      </div>
    </aside>
    <section
      class="flex-1 grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 xl:grid-cols-4 gap-6"
    >
      {
        test_items.map((item) => (
          <div class="grid grid-cols-[1fr,auto] gap-x-2 gap-y-1 group">
            <div class="col-span-2 w-full bg-kuro-dark1 mb-2 relative overflow-hidden rounded-sm">
              <button class="hidden group-hover:block absolute top-3 right-3 z-10 backdrop-blur-2xl p-2 rounded-sm bg-kuro-lavender-900/30">
                <ExtLinkIcon />
              </button>
              <ImageWrapper
                src={`https://fuskylabs-cdn.imgix.net/${item.img}?w=1280&h=1280&fm=webp`}
                class="aspect-auto sm:aspect-square object-cover w-full"
                alt=""
              />
            </div>
            <span class="text-white">{item.artist}</span>
            <span class="text-white text-sm font-kuro-mono text-right">
              $0.00
            </span>
            <span class="text-sm font-kuro-mono text-kuro-violet-50/65">
              {item.type}
            </span>
          </div>
        ))
      }
    </section>
  </div>
</MainLayout>

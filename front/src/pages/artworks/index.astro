---
import Clamp from "$components/Clamp.astro";
import ImageWrapper from "$components/ImageWrapper.astro";
import MainLayout from "$layouts/MainLayout.astro";
import { ExtLinkIcon } from "$components/icons";
import test_items from "./cuties.json"

const SonaOptions = [
  { key: "all", label: "All", href: "/artworks" },
  {
    key: "kuro",
    label: "Kuro",
    href: "/artworks/character/kuro"
  },
  {
    key: "kinter",
    label: "Kinter",
    href: "/artworks/character/kinter"
  }
] as const
---

<MainLayout title="Artworks" description="Look at all of these cuties, goddamn">
  <Clamp class="py-4 flex justify-between text-sm gap-x-2">
    <!-- <Selector client:idle options={SonaOptions} defaultVal="all" /> -->
    <div class="inline-flex items-center gap-x-2.5 px-3">
      <label for="art-category" class="space-x-1">
        <span>Category</span>
        <select name="art-category" id="art-category" class="bg-kuro-dark2 border border-kuro-lavender-100/50 text-sm py-1 px-1.5 rounded-sm">
          <option value="all">All</option>
          <option value="all">Icon</option>
          <option value="all">Mid</option>
          <option value="comms">Fullbody</option>
        </select>
      </label>
      <label for="art-type" class="space-x-1">
        <span>Type</span>
        <select name="art-type" id="art-type" class="bg-kuro-dark2 border border-kuro-lavender-100/50 text-sm py-1 px-1.5 rounded-sm">
          <option value="all">All</option>
          <option value="comms">Commission</option>
          <option value="ych">YCH</option>
          <option value="free-gift-art">Free/Gift Art</option>
          <optgroup label="Special">
            <option value="">Prize winner</option>
          </optgroup>
        </select>
      </label>

      <label for="price-currency" class="space-x-1">
        <span>Currency</span>
        <select name="price-currency" id="price-currency" class="bg-kuro-dark2 border border-kuro-lavender-100/50 text-sm py-1 px-1.5 rounded-sm">
          <option value="usd">USD</option>
          <option value="php">PHP</option>
        </select>
      </label>
    </div>
  </Clamp>
  <div class="px-3">
    <section class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 xl:grid-cols-4 gap-6">
      {
        test_items.map((item) => (
          <div class="grid grid-cols-[1fr,auto] gap-x-2 gap-y-1 group">
            <div class="col-span-2 w-full bg-kuro-dark1 mb-2 relative overflow-hidden rounded-sm">
              <button class="hidden group-hover:block absolute top-3 right-3 z-10 backdrop-blur-2xl p-2 rounded-sm bg-kuro-lavender-900/30">
                <ExtLinkIcon />
              </button>
              <ImageWrapper
                src={`https://fuskylabs-cdn.imgix.net/${item.img}?w=1280&h=1280&fm=webp`}
                class="aspect-auto sm:aspect-square object-cover w-full"
                alt=""
              />
            </div>
            <span class="text-white">{item.artist}</span>
            <span class="text-white text-sm font-kuro-mono text-right">
              $0.00
            </span>
            <span class="text-sm font-kuro-mono text-kuro-violet-50/65">
              {item.type}
            </span>
          </div>
        ))
      }
    </section>
  </div>
</Layout>

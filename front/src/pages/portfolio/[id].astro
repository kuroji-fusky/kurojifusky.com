---
import Clamp from "$components/Clamp.astro";
import MainLayout from "$layouts/MainLayout.astro";
import { getEntry } from "astro:content";

const { protocol, hostname, href } = Astro.url;
const { id } = Astro.params;

const constructedUrl = new URL(href, `${protocol}//${hostname}`).toString();

if (id === undefined) {
  return Astro.redirect(constructedUrl, 404);
}

const showcaseItem = await getEntry("portfolio", id!);
if (showcaseItem === undefined) {
  return Astro.redirect(constructedUrl, 404);
}
---

<MainLayout title={showcaseItem.data.title}>
  <Clamp>
    <span>
      {JSON.stringify(showcaseItem)}
    </span>
  </Clamp>
</Layout>

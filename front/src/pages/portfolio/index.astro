---
import Clamp from "$lib/components/Clamp.astro";
import Link from "$lib/components/Link.svelte";
import SectionPlain from "$lib/components/Sections/SectionPlain.astro";
import Layout from "$layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const showcaseItem = await getCollection("portfolio");
const sortedShowcaseItem = showcaseItem
  .sort((a, b) => b.data.year - a.data.year)
  .filter((i) => i.data.isFeatured)
---

<Layout title="Portfolio" description="A shit">
  <Clamp class="space-y-16 pt-8 my-12">
    <div class="px-6">the yawa</div>
    <SectionPlain level={2} heading="Development" class="contents">
      <ul class="grid gap-8">
        {
          sortedShowcaseItem.map((mm) => (
            <div class="grid grid-cols-8 gap-x-6">
              <a
                class="aspect-video bg-blue-500 col-span-2"
                href={`/portfolio/${mm.id}`}
              />
              <div class="col-span-3 space-y-1.5">
                <h2 class="font-bold text-xl lg:text-2xl">
                  <a href={`/portfolio/${mm.id}`}>{mm.data.title}</a>
                </h2>
                <div class="text-sm opacity-75">
                  <span class="font-kuro-mono">{mm.data.year}</span>
                  {/* <span>{mm.data.type}</span> */}
                </div>
                <div class="text-sm inline-flex gap-x-2.5">
                  <Link href="https://example.com">View site</Link>
                  <Link href="https://github.com/f/f">Source code</Link>
                </div>
              </div>
              <div class="col-span-3">
                <p>{mm.data.excerpt}</p>
              </div>
            </div>
          ))
        }
      </ul>
    </SectionPlain>
    <SectionPlain
      level={2}
      heading="Freelance video editing work"
      class="grid gap-4"
    >
      <div class="grid grid-cols-8 gap-x-6">
        <a class="aspect-video bg-blue-500 col-span-2" href={`/`}></a>
        <div class="col-span-6 space-y-2.5">
          <h2 class="font-bold text-xl lg:text-2xl">
            <a href={`/`}>A nice video</a>
          </h2>
          <div class="text-sm flex items-center gap-x-2">
            <span class="opacity-75">{"From "}</span>
            <a
              href="https://example.com"
              class="inline-flex items-center gap-x-1"
            >
              <div
                class="inline-block size-6 rounded-full aspect-square bg-red-500"
              >
              </div>
              <span class="font-semibold" translate="no">Kinro 4ever</span>
            </a>
          </div>
          <div class="text-sm">
            <Link href="https://youtu.be/lol">Watch on YouTube</Link>
          </div>
        </div>
      </div>
    </SectionPlain>
    <SectionPlain level={2} heading="Others" noHeading>
      <a href="/legacy">Other legacy work</a>
    </SectionPlain>
  </Clamp>
</Layout>

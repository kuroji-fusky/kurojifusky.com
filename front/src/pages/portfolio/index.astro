---
import Clamp from "$components/Clamp.svelte"
import Layout from "$layouts/Layout.astro"
import { getCollection } from "astro:content"

const showcaseItem = await getCollection("portfolio")
const sortedShowcaseItem = showcaseItem.sort((a, b) => b.data.year - a.data.year)
---

<Layout title="Portfolio">
  <h1 class="sr-only">Portfolio</h1>
  <Clamp class="space-y-20 mt-12 mb-24">
      {
        sortedShowcaseItem.map((mm) => (
          <a class="block" href={`/portfolio/${mm.id}`}>
            <h2>{mm.data.title}</h2>
            <span>{mm.data.year}</span>
            <span>{mm.data.type}</span>
          </a>
        ))
      }
  </Clamp>
</Layout>

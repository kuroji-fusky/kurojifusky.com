---

import { Navbar, Footer } from "$components/base";
import { Schema } from "astro-seo-schema";
import { siteTitle } from "$lib/utils";

import SearchPalette from "$components/SearchPalette.astro";

import BaseLayout from "./BaseLayout.astro";
import type { ExtractAstroProps } from "./shared";

type Props = ExtractAstroProps<typeof BaseLayout>;

const { props, site, url } = Astro;

const { description, title: propTitle, webpageType } = props;
const { pathname } = url;

const canonicalUrl = new URL(pathname, site).toString();
const title = pathname !== "/" ? `${propTitle} | ${siteTitle}` : propTitle;
---

<BaseLayout {title} {description} {canonicalUrl} {webpageType}>
  {/* Schema */}
  <Schema
    slot="other-head"
    item={{
      "@context": "https://schema.org",
      "@type": "WebSite",
      name: title,
      description,
      url: canonicalUrl.toString(),
    }}
  />

  {/* Analytics */}
  <script
    slot="other-head"
    is:inline
    defer
    src="https://plausible.io/js/script.js"
    data-domain={site?.hostname}></script>

  <Navbar />
  <main id="skip-to-content">
    <slot />
    <kuro-cutie-assistant state="idle"> </kuro-cutie-assistant>
  </main>
  <Footer />
  <!-- <SearchPalette /> -->
</BaseLayout>

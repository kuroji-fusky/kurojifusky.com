---
import { siteAuthorHandle as me, siteTitle } from "$lib/utils"
import "../styles/global.css"

import Footer from "$components/Footer.astro"
import Navbar from "$components/Navbar"
import NavList from "$components/Navbar/NavList.svelte"
import { Schema } from "astro-seo-schema"
import { getCollection } from "astro:content"

interface Props {
  title: string
  description?: string
  webpageType?: "website" | "article"
  crumbs?: {
    text: string
    link: string
  }[]
}

const { site } = Astro

const { title, description, webpageType = "website" } = Astro.props

const { pathname } = Astro.url

const canonicalUrl = new URL(pathname, Astro.site)
const _title = pathname !== "/" ? `${title} | ${siteTitle}` : title

// Content to be spoon-fed in the cilent navbar
const portaPotty = await getCollection("portfolio")
const featuredPorty = portaPotty
  .filter((i) => i.data.isFeatured)
  .map(({ id, data }) => ({
    text: data.title,
    href: `/portfolio/${id}`
  }))

const NAV_ITEMS = [
  {
    text: "Portfolio",
    href: "/portfolio",
    rowSpan: 2,
    subitems: featuredPorty
  },
  {
    href: "/blog",
    text: "Blog",
    subitems: [
      { href: "/blog/engineering", text: "Engineering" },
      { href: "/blog/ui-and-design", text: "Design" },
      { href: "/blog/others", text: "Others" }
    ]
  },
  {
    href: "/artworks",
    text: "Artworks",
    subitems: [
      { href: "/artworks/kuro", text: "Kuro" },
      { href: "/artworks/kinter", text: "Kinter" },
      { href: "/artworks/ref-sheets", text: "Reference sheets" }
    ]
  },
  {
    text: "About",
    href: "/about",
    rowSpan: 2,
    subitems: [
      { text: "Branding", href: "/about/branding" },
      { text: "Thanks", href: "/about/thanks" },
      { text: "Contact", href: "/contact" }
    ]
  }
]
---

<html lang="en" class="scroll-pt-20 scheme-dark">
  <head>
    <meta charset="utf-8" />
    <title>{_title}</title>

    <link rel="shortcut icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" href="/icon_128.png" sizes="128x128" />

    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />

    {/* OG tags */}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_title" content={siteTitle} />
    <meta property="og:type" content={webpageType} />
    <meta property="og:url" content={canonicalUrl} />

    {
      /* Twitter tags, won't include "twitter:title" since it falls back to "og:*" meta tags */
    }
    <meta name="twitter:creator" content={me} />
    <meta name="twitter:site" content={me} />
    <meta name="twitter:url" content={canonicalUrl} />

    <link rel="canonical" href={canonicalUrl} />

    {/* Sitemap */}
    <Schema
      item={{
        "@context": "https://schema.org",
        "@type": "WebSite",
        name: title,
        url: site!.toString(),
      }}
    />

    {/* Sitemap */}
    <link rel="sitemap" href="/sitemap-index.xml" />

    <slot name="other-meta" />
  </head>
  <body
    class="font-kuro-body font-medium text-sm lg:text-base bg-kuro-dark2 text-kuro-violet-50 overflow-x-hidden selection:bg-kuro-lavender-600 hover:[&_button]:cursor-pointer"
  >
    <script>
      customElements.define(
        "kuro-clamp-container",
        class extends HTMLElement {
          constructor() {
            super();
          }
        },
      );
    </script>
    <a
      href="#skip-to-content"
      class="fixed top-2 left-2 pointer-events-none focus:pointer-events-auto focus:opacity-100 focus:translate-x-0 translate-x-full opacity-0 bg-kuro-lavender-700 z-50 px-4 py-2.5 rounded-md"
      data-astro-prefetch="false">Skip to content?</a
    >
    <Navbar client:idle>
      {
        NAV_ITEMS.map(({ href, text }) => (
          <a
            slot="shortNav"
            role="menuitem"
            {href}
            class:list={[
              "squishy-button before:hidden lg:before:block",
              "px-3 py-1.5",
              pathname.startsWith(href) ? "text-kuro-lavender-200" : null,
            ]}
            aria-current={pathname === href ? "page" : null}
            data-current-root-route={
              pathname.startsWith(href) ? "" : undefined
            }
          >
            {text}
          </a>
        ))
      }
      {
        NAV_ITEMS.map(({ href: hrefHeading, text: textHeading, subitems, rowSpan }) => (
          <div
            slot="longNav"
            role="listbox"
            class="space-y-2"
            style={
              rowSpan
                ? `grid-row: span ${rowSpan}/span ${rowSpan}`
                : undefined
            }
          >
            <NavList {hrefHeading} {textHeading} client:media="(width <= 64rem)">
              {subitems.map(({ href, text }) => (
                <a {href} class="block text-lg">
                  {text}
                </a>
              ))}
            </NavList>
          </div>
        ),
      )}
    </Navbar>
    <div id="skip-to-content">
      <slot />
    </div>
    <Footer />
  </body>
</html>

<style is:global lang="postcss">
  @reference "../styles/global.css";

  .squishy-button {
    @apply relative before:duration-[250ms] before:pointer-events-none before:absolute before:-z-10 before:rounded-sm before:size-full before:inset-0 before:transition-all hover:before:bg-kuro-lavender-200/20 before:scale-[0.96] hover:before:scale-100;
  }
</style>

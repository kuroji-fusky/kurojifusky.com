---
import { siteAuthorHandle as me, siteTitle } from "$lib/utils"
import "../styles/global.css"

import Footer from "$components/Footer.astro"
import Navbar from "$components/Navbar/Navbar.astro"
import NavList from "$components/Navbar/NavList.svelte"
import PreloadFont from "$components/PreloadFont.astro"

import { Schema } from "astro-seo-schema"
import { getCollection } from "astro:content"
import { ClientRouter } from "astro:transitions"

import inter400 from "@fontsource/inter/files/inter-latin-400-normal.woff2?url"
import inter400italic from "@fontsource/inter/files/inter-latin-400-italic.woff2?url"
import inter700 from "@fontsource/inter/files/inter-latin-700-normal.woff2?url"
import unbounded400 from "@fontsource/unbounded/files/unbounded-latin-400-normal.woff2?url"

import ibmPlex400 from "@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-400-normal.woff2?url"

interface Props {
  title: string
  description?: string
  webpageType?: "website" | "article"
  crumbs?: {
    text: string
    link: string
  }[]
}

const { props, url, site } = Astro

const {
  title,
  description,
  webpageType = "website"
} = props
const { pathname } = url

const canonicalUrl = new URL(pathname, site)
const _title = pathname !== "/" ? `${title} | ${siteTitle}` : title

// Content to be spoon-fed in the cilent navbar
const portaPotty = await getCollection("portfolio")
const featuredPorty = portaPotty
  .filter((i) => i.data.isFeatured)
  .map(({ id, data }) => ({
    text: data.title,
    href: `/portfolio/${id}`
  }))

const NAV_ITEMS = [
  {
    text: "Portfolio",
    href: "/portfolio",
    rowSpan: 2,
    subitems: featuredPorty
  },
  {
    href: "/blog",
    text: "Blog"
  },
  {
    href: "/artworks",
    text: "Artworks",
    subitems: [
      { href: "/artworks/kuro", text: "Kuro" },
      { href: "/artworks/kinter", text: "Kinter" },
      { href: "/artworks/ref-sheets", text: "Reference sheets" }
    ]
  },
  {
    text: "About",
    href: "/about",
    rowSpan: 2,
    subitems: [
      { text: "Branding", href: "/about/branding" },
      { text: "Thanks", href: "/about/thanks" },
      { text: "Contact", href: "/contact" }
    ]
  }
]
---

<html lang="en" class="scroll-pt-20 scheme-dark">
  <head>
    <meta charset="utf-8" />
    <title>{_title}</title>

    <link rel="shortcut icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" href="/icon_128.png" sizes="128x128" />

    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />

    {/* OG tags */}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_title" content={siteTitle} />
    <meta property="og:type" content={webpageType} />
    <meta property="og:url" content={canonicalUrl} />

    {
      /* Twitter tags, won't include "twitter:title" since it falls back to "og:*" meta tags */
    }
    <meta name="twitter:creator" content={me} />
    <meta name="twitter:site" content={me} />
    <meta name="twitter:url" content={canonicalUrl} />

    <link rel="canonical" href={canonicalUrl} />

    {/* Preload stuff */}
    <PreloadFont
      urls={[inter400, inter400italic, inter700, unbounded400, ibmPlex400]}
    />

    {/* Schema */}
    <Schema
      item={{
        "@context": "https://schema.org",
        "@type": "WebSite",
        name: title,
        description,
        url: canonicalUrl.toString(),
      }}
    />

    {/* Sitemap */}
    <link rel="sitemap" href="/sitemap-index.xml" />

    <ClientRouter />

    <slot name="other-meta" />
  </head>
  <body
    class="font-kuro-body font-medium text-sm lg:text-base bg-kuro-dark2 text-kuro-violet-50 overflow-x-hidden selection:bg-kuro-lavender-600 hover:[&_button]:cursor-pointer"
    transition:animate="none"
  >
    <div class="">
    <Navbar />
      <div id="skip-to-content">
        <slot />
      </div>
      <Footer />
    </div>
  </body>
</html>
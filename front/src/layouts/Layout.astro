---
import "../styles/global.css";

import { siteTitle } from "$lib/utils";
import { Navbar, Footer } from "$components/base";
import PreloadFont from "$components/PreloadFont.astro";
import Meta from "$components/base/Meta.astro";
import { Schema } from "astro-seo-schema";
import { ClientRouter } from "astro:transitions";
import inter400 from "@fontsource/inter/files/inter-latin-400-normal.woff2?url";
import inter400italic from "@fontsource/inter/files/inter-latin-400-italic.woff2?url";
import inter700 from "@fontsource/inter/files/inter-latin-700-normal.woff2?url";
import unbounded400 from "@fontsource/unbounded/files/unbounded-latin-400-normal.woff2?url";
import ibmPlex400 from "@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-400-normal.woff2?url";
import SearchPalette from "$components/SearchPalette.astro";

type MetaProps = Omit<Parameters<typeof Meta>[0], "canonicalUrl">;
interface Props extends MetaProps {}

const { props, url, site } = Astro;

const { title: titeProp, description, webpageType = "website" } = props;
const { pathname } = url;

const canonicalUrl = new URL(pathname, site).toString();
const title = pathname !== "/" ? `${titeProp} | ${siteTitle}` : titeProp;
---

<html lang="en" class="scroll-pt-20 dark:scheme-dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link rel="shortcut icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" href="/icon_128.png" sizes="128x128" />

    <Meta {title} {description} {webpageType} {canonicalUrl} />

    {/* Preload stuff */}
    <PreloadFont
      urls={[inter400, inter400italic, inter700, unbounded400, ibmPlex400]}
    />

    {/* Schema */}
    <Schema
      item={{
        "@context": "https://schema.org",
        "@type": "WebSite",
        name: title,
        description,
        url: canonicalUrl.toString(),
      }}
    />

    {/* Sitemap and RSS */}
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      href={new URL("rss.xml", site).toString()}
      type="application/rss+xml"
    />

    {/* Analytics */}
    <script
      is:inline
      defer
      src="https://plausible.io/js/script.js"
      data-domain={site?.hostname}></script>

    {/* Client stuff */}
    <script>
      import("$components/FocusLock");
    </script>

    <ClientRouter />
  </head>
  <body
    class="font-kuro-body font-medium text-sm lg:text-base bg-kuro-dark2 text-kuro-violet-50 overflow-x-hidden selection:bg-kuro-lavender-600 hover:[&_button]:cursor-pointer"
    transition:animate="none"
  >
    <style is:global>
      focus-lock-region {
        display: contents;
      }
    </style>
    <Navbar />
    <main id="skip-to-content">
      <slot />
      <kuro-cutie-assistant state="idle"> </kuro-cutie-assistant>
    </main>
    <Footer />
    <!-- <SearchPalette /> -->
  </body>
</html>

---
import "../styles/global.css";
import MetaTags from "./MetaTags.astro";
import { footerNav } from "./navMap";
import Navbar from "./Navbar.svelte";
import Sidebar from "./Sidebar.svelte";
import Link from "$lib/components/Link.svelte";
import { ClientRouter } from "astro:transitions";
import type { ExtractAstroProps } from "./shared";
import { KuroLogoBrand, MenuIcon } from "$lib/components/icons";

interface Props extends ExtractAstroProps<typeof MetaTags, "canonicalUrl"> {
  contentPadding?: boolean;
}

const {
  site,
  url: { pathname },
} = Astro;

const canonicalUrl = new URL(pathname, site).toString();

const { contentPadding, title, description } = Astro.props;
---

<!-- oh hey~ -->
<html lang="en" dir="ltr" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />

    <MetaTags {title} {description} {canonicalUrl} />
    <ClientRouter />
  </head>
  <body
    class="antialiased font-kuro-body dark:bg-neutral-950 dark:text-white text-sm overflow-x-hidden"
  >
    <div
      class="grid grid-rows-[1fr_auto] h-dvh lg:*:ml-(--sidebar-width)"
      style="--sidebar-width: 230px"
    >
      <Navbar client:load>
        <KuroLogoBrand
          slot="branding"
          width="16px"
          height="16px"
          aria-label="Kuro logo"
        />
        <MenuIcon slot="menuIcon" />
      </Navbar>
      <Sidebar client:idle ssr_currentPath={pathname} transition:persist />
      <div
        data-root-content=""
        class:list={["relative", !contentPadding ? "mt-14" : ""]}
      >
        <slot />
      </div>
      <footer>
        <div class="px-4 pt-10 pb-6 justify-center flex">
          <span class="opacity-40 mr-6">© 2025 Kuroji Fusky LLC</span>
          <ul class="inline-flex space-x-3">
            {
              footerNav?.map((item) => (
                <li>
                  <Link href={item.link} class="whitespace-nowrap">{item.text}</Link>
                </li>
              ))
            }
          </ul>
        </div>
      </footer>
    </div>
  </body>
</html>

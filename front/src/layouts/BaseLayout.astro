---
import "../styles/global.css";
import MetaTags from "./MetaTags.astro";
import { ClientRouter } from "astro:transitions";
import type { ExtractAstroProps } from "./shared";

interface Props extends ExtractAstroProps<typeof MetaTags, "canonicalUrl"> {
  contentPadding?: boolean;
  class?: boolean;
}

const {
  site,
  url: { pathname },
} = Astro;

const canonicalUrl = new URL(pathname, site).toString();

const { contentPadding, title, description, class: _class } = Astro.props;
---

<!-- oh hey~ -->
<html lang="en" dir="ltr" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="shortcut icon" href="/favicon.ico" type="image/x-icon" />

    <MetaTags {title} {description} {canonicalUrl} />
    <ClientRouter />
  </head>
  <body
    class:list={[
      "font-xp-body dark:bg-(--global-bg,var(--color-neutral-950)) dark:text-white text-sm overflow-x-hidden",
      _class,
    ]}
  >
    <slot />
    {

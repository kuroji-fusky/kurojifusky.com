---
import "../styles/global.css";
import MetaTags from "./MetaTags.astro";
import { ClientRouter } from "astro:transitions";
import type { ExtractAstroProps } from "./shared";
import Navbar from "../lib/navbar.svelte";
import Stamps from "./Stamps.astro";

interface Props extends ExtractAstroProps<typeof MetaTags, "canonicalUrl"> {
  contentPadding?: boolean;
  class?: boolean;
}

const {
  site,
  url: { pathname },
} = Astro;

const canonicalUrl = new URL(pathname, site).toString();

const { title, description, class: _class } = Astro.props;
---

<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="shortcut icon" href="/favicon.ico" type="image/x-icon" />

    <MetaTags {title} {description} {canonicalUrl} />
  </head>
  <body
    class:list={[
      "font-xp-body dark:bg-(--global-bg,var(--color-neutral-800)) dark:text-white text-sm overflow-x-hidden",
      _class,
    ]}
  >
    <slot />
    <footer class="flex flex-col justify-center items-center mb-18">
      <div class="px-4 pt-10 pb-6">
        <span class="opacity-40 mr-6">© 2026 Kuroji Fusky LLC</span>
      </div>
      <Stamps />
    </footer>
  </body>
</html>

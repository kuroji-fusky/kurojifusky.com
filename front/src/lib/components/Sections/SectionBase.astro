---
import { kebabCase } from "lodash-es";

interface Props {
  class?: string;
  containerClass?: string[] | string;
  heading: string;
  action?: {
    l: string;
    t: string;
  };
}

const { heading, class: cn, containerClass, action, ...others } = Astro.props;
---

<section id={kebabCase(heading)} class:list={containerClass} {...others}>
  <slot name="heading" />
  <div class={cn}>
    <slot />
  </div>
</section>

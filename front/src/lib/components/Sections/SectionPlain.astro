---
import Link from "$components/Link.astro";
import { kebabCase } from "lodash-es";
import SectionBase from "./SectionBase.astro";

interface Props {
  heading: string;
  level?: 1 | 2;
  potentalAction?: {
    l: string;
    t: string;
  };
  class?: string;
  noHeading?: boolean;
}

const { heading, noHeading, potentalAction, level = 2, class: cn } = Astro.props;

const kebabedHeading = kebabCase(heading);
const k_labelledby = `${kebabedHeading}-${crypto.randomUUID().split("-")[0]}`;
---

<SectionBase
  {heading}
  containerClass="mx-6"
  class={cn}
  aria-label={!noHeading ? heading : undefined}
>
  {
    !noHeading ? (
      <div
        class:list={[
          "flex items-center gap-x-3 mb-6",
          potentalAction ? "justify-between" : "",
        ]}
      >
        {level === 1 ? (
          <h1 class="font-bold text-2xl lg:text-3xl">{heading}</h1>
        ) : (
          <h2 class="font-bold text-2xl lg:text-3xl">{heading}</h2>
        )}
        {potentalAction ? (
          <Link href={potentalAction.l}>{potentalAction.t}</Link>
        ) : null}
      </div>
    ) : null
  }
  <slot />
</SectionBase>

---
import { twMerge } from "tailwind-merge";

interface Props {
  id: string;
  lazy?: boolean;
  /** If true, the player changes the aspect ratio to 9/16 */
  shorts?: boolean;
  class?: string;
}

const { id, lazy, shorts, class: _class } = Astro.props;

const NOCOOKIE = `https://www.youtube-nocookie.com/embed/${id}`;

const jizzInMyPants = `player-${crypto.randomUUID()}`;
---

<div
  data-youtube-embed=""
  class={twMerge("aspect-video overflow-hidden", _class)}
  data-yt-lazy={Boolean(lazy)}
>
  {
    lazy ? (
      <div id={jizzInMyPants} />
    ) : (
      <iframe
        id={jizzInMyPants}
        src={NOCOOKIE}
        frameborder="0"
        class="size-full"
      />
    )
  }
</div>

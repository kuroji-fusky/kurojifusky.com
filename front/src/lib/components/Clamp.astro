---
import { twMerge } from "tailwind-merge";

interface Props {
  class?: string;
  as?: keyof HTMLElementTagNameMap;
}

const { class: cls, as: Element = "div" } = Astro.props;
const mergedClasses = twMerge("block mx-auto max-w-7xl", cls);
---

<Element data-clamp-container="" class={mergedClasses}>
  <slot />
</Element>

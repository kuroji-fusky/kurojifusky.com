---
import { ChevronRightIcon, ExtLinkIcon } from "$components/icons";
import { kebabCase } from "lodash-es";
import { footerLinks, navLinks } from "./links";

// Map all the random UUIDs to dem items so it's easy to track them when iterating the items and the buttons
const newNavvies = navLinks.map((items) => {
  // Only applying the root items instead of its subitems since that's what it'll refer from
  // when toggling different states
  const trueRnd = crypto.randomUUID().split("-")[0];

  return {
    // Append the random UUID if it only has subitems
    id: items.subitems ? `${kebabCase(items.text)}-${trueRnd}` : null,
    ...items,
  };
});
---

<style is:global>
  /* Initial styles to prevent from showing content on page load, will automatically add inline styles on client */
  mobile-drawer[transition-direction="left"]:not([open]) {
    transform: translate3d(-100%, 0, 0);
  }
</style>

<mobile-drawer
  id="global-nav-mobile"
  role="navigation"
  class="block md:hidden overflow-x-hidden fixed top-10 inset-x-0 z-10 h-full"
  transition-direction="left"
>
  <div
    class="p-3.5 grid gap-x-0.5 text-sm select-none bg-black absolute top-0 w-full z-10"
  >
    {
      newNavvies.map(({ text, subitems, id }) => (
        <button
          data-subitem={id ?? undefined}
          class="flex items-center px-2.5 py-2 rounded-md group hover:bg-kuro-lavender-100/10"
        >
          <span class="flex-1 text-left">{text}</span>
          {subitems && (
            <ChevronRightIcon
              width="1em"
              height="1em"
              class="opacity-50 group-hover:opacity-90"
            />
          )}
        </button>
      ))
    }
    <div class="my-2 px-2.5">
      <hr class="border-slate-400/50 w-full" />
    </div>
    {
      footerLinks.map(({ href, text, icon: Icon }) => (
        <a
          {href}
          role="listitem"
          class="flex items-center gap-x-1.5 px-2.5 py-2 rounded-md group hover:bg-kuro-lavender-100/10"
          target={href.startsWith("http") ? "_blank" : undefined}
        >
          <Icon class="shrink-0" />
          <span class="flex-1">{text}</span>
          {href.startsWith("http") ? (
            <ExtLinkIcon class="shrink-0 opacity-50 group-hover:opacity-90" />
          ) : null}
        </a>
      ))
    }
  </div>
  {
    newNavvies.map(
      ({ subitems, id }) =>
        subitems && (
          <focus-lock-region>
            <ul
              data-submenu={id}
              class="p-3.5 grid absolute top-0 left-0 translate-x-full opacity-0 not-[[inert]]:translate-x-0 not-[[inert]]:opacity-100 w-full z-10"
              inert=""
            >
              {subitems.map(({ href, text }) => (
                <li>
                  <a
                    {href}
                    class="flex items-center gap-x-1.5 px-2.5 py-2 rounded-md group hover:bg-kuro-lavender-100/10"
                  >
                    {text}
                  </a>
                </li>
              ))}
            </ul>
          </focus-lock-region>
        ),
    )
  }
</mobile-drawer>

<script>
  await import("$components/MobileDrawer");

  // This event listener will retrigger all the events after a full transition
  document.addEventListener("astro:page-load", () => {
    const container = document.querySelector(
      "#nav-drawer > div",
    ) as HTMLElement;
    const subItems = Array.from(
      document.querySelectorAll<HTMLButtonElement>("[data-subitem]"),
    );

    for (const subItemButton of subItems) {
      subItemButton.addEventListener("click", () => {
        const selectedSubmenu = container.parentElement!.querySelector(
          `[data-submenu="${subItemButton.dataset.subitem}"]`,
        );

        selectedSubmenu?.removeAttribute("inert");

        // Add an active marker if it doesn't exist, mainly on page load
        if (!!container.dataset.submenuActive) return;
        container.setAttribute("data-submenu-active", "");
      });
    }
  });
</script>

---
interface Props {
  title: string;
  description: string;
  webpageType?: "website" | "article";
  canonicalUrl: string;
}

const { title, description, webpageType, canonicalUrl } = Astro.props;

import { siteAuthorHandle as me } from "$lib/utils";

const SITE_TITLE = "The Fusky Corner";
---

<title>{title}</title>
{description && <meta name="description" content={description} />}

{/* OG tags */}
<meta property="og:title" content={title} />
{description && <meta property="og:description" content={description} />}
<meta property="og:site_title" content={SITE_TITLE} />
<meta property="og:type" content={webpageType} />
<meta property="og:url" content={canonicalUrl} />

{
  /* Twitter tags, won't include "twitter:title" since it falls back to "og:*" meta tags */
}
<meta name="twitter:title" content={title} />
{description && <meta name="twitter:description" content={description} />}
<meta name="twitter:creator" content={me} />
<meta name="twitter:site" content={me} />
<meta name="twitter:url" content={canonicalUrl} />

<link rel="canonical" href={canonicalUrl} />

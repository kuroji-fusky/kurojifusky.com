---
import Clamp from "../Clamp.astro";
import Link from "../Link.astro";

import { footerLinks } from "./links";
---

<Clamp class="py-6 relative flex gap-y-2.5 px-6 select-none">
  <footer class="flex flex-col gap-y-8 text-sm flex-1">
    <div
      class="flex justify-between font-light"
    >
      <span class="opacity-50" translate="no">{`© Kerby Keith Aquino`}</span>
      <div
        class="hidden md:flex font-kuro-mono gap-x-4 items-start md:items-center gap-y-4 flex-col md:flex-row"
      >
        {footerLinks.map((i) => <Link href={i.href}>{i.text}</Link>)}
      </div>
    </div>
  </footer>
</Clamp>

---
import { navLinks } from "./links";
---

<script>
  import { debounce } from "lodash-es";
  import { animate, hover } from "motion";

  document.addEventListener("astro:page-load", () => {
    const globalLinks = document.querySelectorAll("#global-link");

    hover(globalLinks, (el) => {
      animate(el, { y: -2 });

      return () => animate(el, { y: 0 });
    });
  });
</script>

<div class="flex justify-center">
  <div
    class="hidden md:flex items-center gap-x-3 text-sm select-none font-kuro-mono"
  >
    {
      navLinks.map(({ href, text }) => (
        <a id="global-link" {href} class="py-1.5 px-2 rounded-md">
          {text}
        </a>
      ))
    }
  </div>
  <div id="breadcrumb" style="display: none"></div>
</div>

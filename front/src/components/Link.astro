---
import { ExtLinkIcon } from "./icons";

interface Props {
  href: string;
  class?: string;
  noReferrer?: true;
  explicitIcon?: boolean;
}

const { href, class: cn, noReferrer, explicitIcon = true } = Astro.props;

const isUrlHasHttp = href.startsWith("http");
---

<a
  data-custom-link=""
  {href}
  rel={noReferrer ? "noreferrer noopener" : undefined}
  target={isUrlHasHttp ? "_blank" : undefined}
  class:list={[
    "inline-block hover:underline text-kuro-lavender-800 hover:text-kuro-lavender-900 dark:text-kuro-lavender-200/75  dark:hover:text-kuro-lavender-200",
    cn,
  ]}
>
  <span><slot /></span>
  {explicitIcon && isUrlHasHttp && <ExtLinkIcon class="float-right ml-1" />}</a
>

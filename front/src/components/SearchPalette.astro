---
import { SearchIcon, XIcon } from "./icons";
---

<script>
  document.addEventListener("astro:page-load", () => {
    console.log("I'm black");
  });
</script>
<div
  id="search-palette"
  class="fixed top-10 inset-x-0 bottom-0 mx-auto max-w-[640px] px-6 z-10 flex flex-col gap-y-3"
>
  <focus-lock-region has-lock-focus>
    <div class="relative flex items-center mt-8 border-b">
      <span
        class="pointer-events-none absolute inset-y-0 left-3 grid place-items-center"
      >
        <SearchIcon />
      </span>
      <input
        id="palette-search"
        type="text"
        role="search"
        class="w-full font-kuro-body pl-10 pr-4 py-3"
        placeholder="Search for something cringe"
      />
      <button class="p-2.5">
        <XIcon />
      </button>
    </div>
    <section class="flex flex-col flex-1 pb-4">yes</section>
  </focus-lock-region>
</div>


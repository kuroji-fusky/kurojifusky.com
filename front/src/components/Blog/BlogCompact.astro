---

<a href="/blog/ss" class="cursor-default hover:cursor-pointer">
  <article class="group p-8">
    <h2
      class="inline font-bold text-2xl/snug text-white before:inset-x-0 before:bottom-0 before:h-3 before:-z-10 before:absolute group-hover:before:bg-kuro-lavender-500/70 p-0.5 relative"
    >
      Title
    </h2>
    <p class="my-1 opacity-65 group-hover:opacity-100">Description</p>
    <time
      class="font-kuro-mono text-sm opacity-65 group-hover:opacity-75"
      datetime="NaN">Date</time
    >
  </article>
</a>

---
import { ExpandIcon, TocIcon } from "../icons";

interface Props {
  blogTitle: string;
}

const { blogTitle } = Astro.props;
---

<div
  class="overflow-hidden mx-auto max-w-screen-lg rounded-md px-2.5 py-1.5 lg:px-12 bg-kuro-lavender-50 dark:bg-kuro-dark2 sticky top-10 backdrop-blur-md flex items-center justify-between"
>
  <div class="flex-1 relative h-[2ch]">
    <span id="tools-label" class="absolute left-0 opacity-50 select-none"
      >Readability</span
    >
    <span id="tools-title" class="absolute left-0 hidden">{blogTitle}</span>
  </div>
  <div class="flex items-center gap-x-0.5">
    <button class="p-1.5 rounded-md bg-red-300/40" title="Expand contents">
      <ExpandIcon width="20" height="20" />
    </button>
    <button class="p-1.5 rounded-md bg-red-300/40" title="Table of contents">
      <TocIcon width="20" height="20" />
    </button>
  </div>
</div>

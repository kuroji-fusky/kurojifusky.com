---
import { ChevronRightIcon, ExpandIcon, TocIcon } from "../icons";

interface Props {
  blogTitle: string;
}

const { blogTitle } = Astro.props;
---

<div
  class="z-10 overflow-hidden mx-auto max-w-screen-lg rounded-md py-3 px-6 bg-kuro-lavender-50 dark:bg-kuro-dark2 sticky top-10 flex items-center justify-between"
>
  <div class="flex-1 relative h-[2ch]">
    <span id="tools-label" class="absolute left-0 opacity-50 select-none"
      >Readability</span
    >
    <ul id="tools-title" class="absolute left-0 hidden gap-x-2 items-center font-normal">
      <li class="inline-flex items-center gap-x-1.5">
        <span class="opacity-75">Stuff</span>
        <ChevronRightIcon width="12" height="12" />
      </li>
      <li class="inline-flex items-center gap-x-1.5">
        <span class="opacity-75">Stuff</span>
        <ChevronRightIcon width="12" height="12" />
      </li>
      <li>
        {blogTitle}
      </li>
    </ul>
  </div>
  <div class="flex items-center gap-x-0.5">
    <button class="p-1.5 rounded-md bg-red-300/40" title="Expand contents">
      <ExpandIcon width="20" height="20" />
    </button>
    <button class="p-1.5 rounded-md bg-red-300/40" title="Table of contents">
      <TocIcon width="20" height="20" />
    </button>
  </div>
</div>

---
import Clamp from "./Clamp.astro"
import Link from "./Link.astro"

const sourceRepoUrl = "https://github.com/kuroji-fusky/kurojifusky.com"

interface Links {
  href: string
  text: string
}

const links = [
  { href: "/links", text: "Links" },
  { href: "/about-me#contact", text: "Contact" },
  { href: sourceRepoUrl, text: "Sauce" }
] satisfies Links[]
---

<Clamp class="py-6 relative flex gap-y-2.5 px-6">
  <footer class="flex flex-col gap-y-8 text-sm flex-1">
    <div
      class="flex flex-col-reverse md:flex-row gap-y-6 justify-between font-light"
    >
      <span class="opacity-50" translate="no">{`© 2025 Fusky Labs LLC`}</span>
      <div
        class="font-kuro-mono flex gap-x-6 items-start md:items-center gap-y-4 flex-col md:flex-row"
      >
        {
          links.map((i) => (
            <Link href={i.href}>
              {i.text}
            </Link>
          ))
        }
      </div>
    </div>
  </footer>
</Clamp>

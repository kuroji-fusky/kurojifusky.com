---
interface Props {
  id: string;
  isShorts?: boolean;
}

const { id: videoId } = Astro.props;
---

<yt-player-client-wrapper
  class="block aspect-video overflow-hidden rounded-md"
  video-id={videoId}
>
  {
    /*
   <iframe
   src={`https://www.youtube-nocookie.com/embed/${videoId}`}
   frameborder="0"
   allow="accelerometer; clipboard-write; encrypted-media; web-share"
   class="size-full"></iframe> 
   */
  }
</yt-player-client-wrapper>
<p class="sr-only">
  <a aria-hidden="true" href={`https://www.youtube.com/watch?v=${videoId}`}>
    <img src={`https://i.ytimg.com/vi/${videoId}/maxresdefault.jpg`} alt="" />
  </a>
</p>

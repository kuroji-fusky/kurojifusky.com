---
import { cn } from "$lib/utils"

interface Props {
  class?: string
}

const { class: cls } = Astro.props
---

<script>
  customElements.define("kuro-clamp-container", 
  class extends HTMLElement {
    constructor() {
      super()
    }
  }
)
</script>

<kuro-clamp-container class={cn(["not-[.flex,.inline-block]:block mx-auto max-w-screen-xl px-6", cls])}>
  <slot />
</kuro-clamp-container>
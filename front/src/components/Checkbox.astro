---
import { kebabCase } from "lodash-es";

interface Props {
  queryValue?: string;
  labelName: string;
  name?: string;
  isChecked?: boolean;
}

const { labelName, queryValue, isChecked } = Astro.props;

const labelKebab = kebabCase(labelName);
const rand = crypto.randomUUID().split("-")[0];

const kebabed = `${labelKebab}-${rand}`;
---

<script>
  import { LitElement, html } from "lit";
  import { customElement } from "lit/decorators.js";

  @customElement("cool-checkbox-thats-not-cringe")
  class CustomCheckbox extends LitElement {
    protected createRenderRoot() {
      return this;
    }
  }
</script>
<cool-checkbox-thats-not-cringe query-value={queryValue}>
  <label for={kebabed} class="contents">
    <input type="checkbox" id={kebabed} />
    <slot><span>{labelName}</span></slot>
  </label>
</cool-checkbox-thats-not-cringe>

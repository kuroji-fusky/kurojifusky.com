{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": "./src",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "paths": {
      "$lib/*": ["lib/*"],
      "$components/*": ["components/*"],
      "$layouts/*": ["layouts/*"],
      "$stores/*": ["stores/*"]
    },
    "types": ["unplugin-icons/types/astro"]
  }
}

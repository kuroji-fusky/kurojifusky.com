{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": "./src",
    "paths": {
      "$lib/*": ["lib/*"],
      "$layouts/*": ["layouts/*"]
    },
    "types": [
      "unplugin-icons/types/astro",
      "@types/youtube"
    ]
  },
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"]
}

---
import SectionBase from "./SectionBase.astro";

interface Props {
  heading: string;
  class?: string;
}

const { heading, class: cn } = Astro.props;
---

<SectionBase containerClass="mx-6" class={cn} heading={heading}>
  <h1
    slot="heading"
    class="flex justify-center mb-5 font-semibold text-3xl lg:text-4xl text-white"
  >
    {heading}
  </h1>
  <slot />
</SectionBase>

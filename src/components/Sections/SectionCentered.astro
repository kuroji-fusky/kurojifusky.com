---
import SectionBase from "./_SectionBase.astro";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<SectionBase containerClass="mx-6" heading={title}>
  <h1
    slot="heading"
    class="flex justify-center mb-5 font-semibold text-3xl lg:text-4xl text-white"
  >
    {title}
  </h1>
  <slot />
</SectionBase>

---
import Link from "$components/Link.astro";
import SectionBase from "./SectionBase.astro";

interface Props {
  heading: string;
  level: 1 | 2
  potentalAction?: {
    l: string;
    t: string;
  };
  class?: string
}

const { heading, potentalAction, level, class:cn } = Astro.props;
---

<SectionBase {heading} containerClass="mx-6" class={cn}>
  <!-- section:plain -->
  <div
    slot="heading"
    class:list={[
      "flex items-center gap-x-3 mb-5",
      potentalAction ? "justify-between" : "",
    ]}
  >
    {
      level === 1 ? (
        <h1 class="font-bold text-3xl lg:text-4xl">{heading}</h1>
      ) : (
        <h2 class="font-bold text-3xl lg:text-4xl">{heading}</h2>
      )
    }
    {
      potentalAction ? (
        <Link href={potentalAction.l}>{potentalAction.t}</Link>
      ) : (
        <!-- potentialAction -->
      )
    }
  </div>
  <slot />
</SectionBase>

---
import Clamp from "./Clamp.astro";
import Link from "./Link.astro";

const sourceRepoUrl = "https://github.com/kurojifusky/kurojifusky.com";

interface Links {
  href: string;
  text: string;
}

const links = [
  { href: "/sitemap", text: "Sitemap" },
  { href: "/links", text: "Socials" },
  { href: "/about-me#contact", text: "Contact" },
  { href: sourceRepoUrl, text: "Sauce" },
] satisfies Links[];

const technologies = [
  { href: "https://pages.cloudflare.com/", text: "Cloudflare Pages" },
  {
    href: "https://www.cloudflare.com/developer-platform/products/r2/",
    text: "R2",
  },
  { href: "https://www.imgix.com/", text: "Imgix" },
] satisfies Links[];
---

<Clamp class="py-6 relative flex gap-y-2.5 px-6">
  <footer class="flex flex-col gap-y-8 text-sm flex-1">
    <span
      id="technology-disclosure"
      class="font-kuro-mono text-sm [&_a]:underline"
    >
      {/* This is cursed lol */}
      {
        technologies.map(({ href, text }, i) => {
          if (i === 0) {
            return (
              <Fragment>{"Content powered by "}<Link {href}>{text}</Link></Fragment>
            );
          } else if (i === technologies.length - 1) {
            return (
              <Fragment>{", and "}<Link {href}>{text}</Link>{"."}</Fragment>
            );
          } else {
            return (
              <Fragment>{", "}<Link {href}>{text}</Link></Fragment>
            );
          }
        })
      }
    </span>
    <div
      class="flex flex-col-reverse md:flex-row gap-y-6 justify-between font-light"
    >
      <span class="opacity-50" translate="no">{`© Fusky Labs LLC`} </span>
      <div
        class="font-kuro-mono flex gap-x-1 items-start md:items-center gap-y-4 flex-col md:flex-row"
      >
        {
          links.map((i) => (
            <a
              href={i.href}
              class="opacity-45 hover:opacity-100 transition-opacity md:mx-2.5"
              target={i.href.startsWith("https") ? "_blank" : undefined}
              rel={
                i.href.startsWith("https") ? "noopenner noreferer" : undefined
              }
            >
              {i.text}
            </a>
          ))
        }
      </div>
    </div>
  </footer>
</Clamp>

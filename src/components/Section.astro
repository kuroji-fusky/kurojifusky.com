---
import { kebabCase } from "lodash-es";

interface Props {
  title: string;
}

const { title } = Astro.props;

const kebabTitle = kebabCase(title);
---

<section class="mx-6" id={kebabTitle}>
  <h1
    class="flex justify-center mb-5 font-semibold text-3xl lg:text-4xl text-white"
  >
    {title}
  </h1>

  <div data-sec-contents="">
    <slot />
  </div>
</section>

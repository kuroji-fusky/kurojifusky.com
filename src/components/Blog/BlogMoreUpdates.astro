---
import ExtLinkIcon from "~icons/lucide/arrow-up-right";
import Link from "$components/Link.astro";
import SectionBase from "$components/Sections/SectionBase.astro";

const socials = [
  {
    logo: "",
    subtext:
      "I'm starting to be active on Bluesky as of late; sometimes, blog posts are tiring to write after all",
    linkAction: "The sky is blue",
    linkText: "bsky.app/profile/kurojifusky.bsky.social",
  },
  {
    logo: "",
    subtext:
      "Occasionally, I post updates on my community tab on my channel, probably some random stuff like I usually do in Bluesky too",
    linkAction: "It's Ain't TikTok",
    linkText: "www.youtube.com/@kurojifusky/community",
  },
  {
    logo: "",
    subtext:
      "For something that's too techinical and super nerdy, I have a Mastodon account under the furry.engineer instance",
    linkAction: "Nerd territory",
    linkText: "furry.engineer/@kurojifusky",
  },
];
---

<SectionBase heading="footnote-more-updates" containerClass="px-6 my-20">
  <h3
    slot="heading"
    class="my-9 text-center font-bold text-4xl lg:text-5xl font-kuro-hero-heading"
  >
    For more updates
  </h3>
  <p class="text-base lg:text-lg text-center mb-12 lg:mb-24 px-6">
    I do have an RSS feed, but I don't do newsletters—but what I <em>do</em> have
  </p>

  <div
    class="grid grid-cols-1 lg:grid-cols-3 gap-y-9 *:flex *:flex-col *:items-center"
  >
    {
      socials.map((item) => (
        <div class="group text-sm lg:text-base mx-9">
          <a href={`https://${item.linkText}`} target="_blank" class="transition-transform group-hover:scale-110">
            <div class="size-28 bg-red-100 rounded-full" />
          </a>
          <p class="pt-4 pb-2.5 lg:pt-6 lg:pb-4 text-center cursor-default">{item.subtext}</p>
          <Link
            href={`https://${item.linkText}`}
            class="group-hover:opacity-100 group-hover:underline inline-flex items-center"
          >
            {item.linkAction}
            <ExtLinkIcon />
          </Link>
        </div>
      ))
    }
  </div>
</SectionBase>

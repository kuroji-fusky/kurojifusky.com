---
interface Props {
  href: string;
  class?: string;
  noReferrer?: true;
  explicitIcon?: true;
}

const { href, class: cn, noReferrer, explicitIcon } = Astro.props;

const isUrlHasHttp = href.startsWith("http");
---

<a
  {href}
  rel={noReferrer ? "noreferrer noopener" : undefined}
  target={isUrlHasHttp ? "_blank" : undefined}
  class:list={[
    "hover:underline text-kuro-lavender-200/75 hover:text-kuro-lavender-200",
    cn,
  ]}><slot /></a
>

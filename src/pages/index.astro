---
import Clamp from "$components/Clamp.astro";
import Hero from "$components/landing/Hero.astro";
import SectionPlain from "$components/Sections/SectionPlain.astro";
import Layout from "$layouts/Layout.astro";
import { Schema } from "astro-seo-schema";

const { site } = Astro;
---

<Layout title="kuro homepage">
  <Hero />
  <Clamp class="my-12 space-y-40 prose-p:leading-relaxed">
    <SectionPlain
      level={1}
      heading="Featured projects"
      potentalAction={{ t: "View all", l: "/portfolio" }}
      class="flex gap-8 items-start"
    >
      <div class="flex-1 sticky top-16 self-start">
        <div class="p-6 rounded-md bg-kuro-lavender-900">
          <h2 class="font-bold text-2xl mb-3">Title</h2>
          <p>
            Lorem ipsum dolor sit amet, consectetur adipisicing elit. Sed
            distinctio quae neque voluptatem laudantium ut harum illum assumenda
            veritatis fuga nulla cum
          </p>
        </div>
      </div>
      <div class="grid gap-y-8 shrink-0 w-96 *:w-full prose-p:text-sm">
        {
          [...Array(2)].map((_, i) => (
            <div>
              <div class="bg-gradient-to-tl from-kuro-lavender-600 to-kuro-royalblue-300 h-max aspect-video rounded-lg" />
              <h2 class="font-bold text-xl mt-3 mb-0.5 leading-relaxed">
                Title
              </h2>
              <p>Lorem ipsum dolor sit amet consectetur.</p>
            </div>
          ))
        }
      </div>
    </SectionPlain>
    <SectionPlain
      level={1}
      heading="Latest updates"
      potentalAction={{ t: "View all", l: "/blog" }}
    >
      <div class="flex w-full gap-4 *:w-full prose-p:text-sm">
        {
          [...Array(3)].map((_, i) => (
            <div class="space-y-1">
              <div class="mb-0 bg-gradient-to-tl from-kuro-lavender-600 to-kuro-royalblue-300 h-max aspect-video rounded-lg" />
              <span class="my-0 inline-block mt-3 text-xs px-2.5 py-0.5 rounded-2xl border">
                Tag
              </span>
              <h2 class="font-bold text-2xl mt-1 mb-0.5 leading-relaxed">
                Title
              </h2>
              <p>Description / excerpt</p>
              <time class="text-sm opacity-65 font-kuro-mono">Date</time>
            </div>
          ))
        }
      </div>
      <div class="mt-12 space-y-4">
        <h2 class="text-center font-bold text-3xl">Browse more what's cookin'</h2>
        <div class="mx-auto flex flex-wrap justify-center items-center gap-x-4 gap-y-1.5 ">
          {
            [...Array(7)].map((_, i) => (
              <span class="inline-block text-base mt-3 px-3.5 py-1 rounded-full border-2">
                Tag
              </span>
            ))
          }
        </div>
      </div>
    </SectionPlain>
    <SectionPlain level={1} heading="About me">Placeholder</SectionPlain>
    <SectionPlain level={2} heading="More">Placeholder</SectionPlain>
  </Clamp>
</Layout>

<Schema
  item={{
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "Kuroji Fusky",
    url: site!.toString(),
  }}
/>

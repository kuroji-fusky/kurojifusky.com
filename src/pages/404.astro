---
import ImageWrapper from "$components/ImageWrapper.astro";
import Layout from "$layouts/Layout.astro";
import oops from "../../public/oops.jpg";
---

<Layout title="Page not found">
  <div class="m-auto grid place-items-center px-6 h-[calc(100dvh-11rem)]">
    <div class="flex flex-col items-center">
      <ImageWrapper
        src={oops.src}
        alt=""
        class="rounded-lg w-60"
      />
      <h1 class="font-bold font-kuro-hero-heading text-7xl leading-none my-5">
        404
      </h1>
      <span class="text-xl text-center"
        >Where you looking for somethin'? Looks like you went to the wrong pile.</span
      >
      <div class="mt-8">
        <a
          href="/"
          class="py-2 px-3.5 bg-kuro-lavender-800 hover:bg-kuro-lavender-700 rounded-md select-none"
          >Take me home</a
        >
      </div>
    </div>
  </div>
</Layout>
